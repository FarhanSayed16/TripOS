{
  "info": {
    "name": "02 TripOS Happy Path Runner",
    "description": "Run this collection in order (Collection Runner). Requires API on :8000, DB seeded, PAYMENTS_MODE=mock, INVENTORY_SUPPLIERS=mock_supplier. Uses admin@tripos.in / password123 from seed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ready",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Auth",
      "item": [
        {
          "name": "Login (agent/admin seed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiBase}}/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{agentEmail}}\",\n  \"password\": \"{{agentPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.expect(j.access_token).to.be.a('string');",
                  "pm.environment.set('accessToken', j.access_token);",
                  "pm.environment.set('adminAccessToken', j.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{apiBase}}/auth/me",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "if (j.active_organization_id) pm.environment.set('organizationId', j.active_organization_id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Customer",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiBase}}/customers",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Tester\",\n  \"phone\": \"+919876543210\",\n  \"email\": \"postman.tester@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.expect(j.id).to.be.ok;",
                  "pm.environment.set('customerId', j.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Search",
      "item": [
        {
          "name": "Search flights (mock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiBase}}/inventory/search/flights",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"flight\",\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"departure_date\": \"2026-11-15\",\n  \"passengers\": { \"adults\": 1, \"children\": 0, \"infants\": 0 },\n  \"sort\": \"recommended\",\n  \"dedupe\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.expect(j.offers.length).to.be.above(0);",
                  "pm.environment.set('searchRequestId', j.search_request_id);",
                  "pm.environment.set('offerJson', JSON.stringify(j.offers[0]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Quote lifecycle",
      "item": [
        {
          "name": "Create quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiBase}}/quotes",
            "description": "agent_markup is in paise (50000 = \u20b9500)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customerId}}\",\n  \"items\": [\n    {\n      \"search_request_id\": \"{{searchRequestId}}\",\n      \"offer\": {{offerJson}},\n      \"agent_markup\": 50000\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.environment.set('quoteId', j.id);",
                  "pm.environment.set('publicToken', j.public_token);",
                  "if (j.items && j.items[0]) pm.environment.set('quoteItemId', j.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add passengers",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiBase}}/quotes/{{quoteId}}/passengers",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"first_name\": \"Postman\",\n    \"last_name\": \"Tester\",\n    \"date_of_birth\": \"1990-01-15\",\n    \"passport_number\": \"A1234567\"\n  }\n]"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark ready",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiBase}}/quotes/{{quoteId}}/ready",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.expect(j.status).to.eql('ready');"
                ]
              }
            }
          ]
        },
        {
          "name": "WhatsApp preview",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{apiBase}}/quotes/{{quoteId}}/whatsapp-preview",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate payment link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiBase}}/quotes/{{quoteId}}/payment",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "if (j.payment_link_url) pm.environment.set('paymentLinkUrl', j.payment_link_url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Public quote (customer view)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/public/quotes/{{publicToken}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.expect(j).to.not.have.property('supplier_cost');"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark paid offline (mock path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiBase}}/quotes/{{quoteId}}/mark-paid-offline",
            "description": "Bypasses Razorpay for local demo. Worker may create booking async \u2014 poll Get quote / List bookings.",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.expect(['paid','ready','sent']).to.include(j.status);",
                  "if (j.booking && j.booking.id) pm.environment.set('bookingId', j.booking.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get quote (after pay)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{apiBase}}/quotes/{{quoteId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "if (j.booking && j.booking.id) pm.environment.set('bookingId', j.booking.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 Bookings & Wallet",
      "item": [
        {
          "name": "List bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{apiBase}}/bookings",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "const list = Array.isArray(j) ? j : (j.items || []);",
                  "if (list[0] && list[0].id) pm.environment.set('bookingId', list[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wallet summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{apiBase}}/wallet/summary",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{apiBase}}/payments",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiBase",
      "value": "http://localhost:8000/api/v1"
    }
  ]
}
