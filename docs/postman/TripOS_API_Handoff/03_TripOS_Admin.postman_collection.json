              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiBase}}/admin/partners",
            "description": "Requires FC_PARTNER_API_ENABLED=true to use the key afterward. api_key returned once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization_id\": \"{{organizationId}}\",\n  \"name\": \"Postman Sandbox Partner\",\n  \"env\": \"test\",\n  \"webhook_url\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const j = pm.response.json();",
                  "if (j.id) pm.environment.set('partnerAppId', j.id);",
                  "if (j.api_key) {",
                  "  pm.environment.set('partnerApiKey', j.api_key);",
                  "  console.log('SAVE api_key now \u2014 shown once:', j.api_key);",
                  "}"
                ]
              }
            }
          ]
