# Environment: development | production (cookie Secure + JWT guard when production)
ENV="development"

# Database (async SQLAlchemy driver)
DATABASE_URL="postgresql+psycopg://tripos:password@localhost:5433/tripos"
REDIS_URL="redis://localhost:6380/0"

# Security — must not be the placeholder when ENV=production
JWT_SECRET="generate_a_strong_secret_key_here"

# Services
RESEND_API_KEY="re_test_dummy_key"
RAZORPAY_KEY_ID="rzp_test_dummy"
RAZORPAY_KEY_SECRET="rzp_test_secret_dummy"
RAZORPAY_WEBHOOK_SECRET=""
PAYMENTS_MODE="mock"
# Set PAYMENTS_MODE=razorpay + real test keys for Sprint I live capture
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
# RAZORPAY_WEBHOOK_SECRET="..."
FRONTEND_URL="http://localhost:3000"
PLATFORM_FEE_PAISE="0"

# Feature Flags
# AI is opt-in (FIX-P35-01). Set true only with OPENAI_API_KEY.
AI_COPILOT_ENABLED="false"
OPENAI_API_KEY=""

# Hierarchy master override (basis points). 2000 = 20%.
MASTER_COMMISSION_OVERRIDE_BPS="2000"

# Document vault — local for dev only; production must use s3|r2 (Phase 6).
DOCUMENT_STORAGE_BACKEND="local"
DOCUMENT_MAX_BYTES="10485760"
DOCUMENT_ALLOWED_MIME="application/pdf,image/jpeg,image/png,image/webp"
# Required when DOCUMENT_STORAGE_BACKEND=s3|r2
DOCUMENT_S3_BUCKET=""
DOCUMENT_S3_ENDPOINT=""
DOCUMENT_S3_ACCESS_KEY=""
DOCUMENT_S3_SECRET_KEY=""
DOCUMENT_S3_REGION="auto"

# Encryption (Fernet) — required for supplier credential storage later
ENCRYPTION_KEY=""

# Sentry (API + worker + optional web NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=""

# Inventory — comma-separated supplier codes. Default mock-only (honest pilot).
# Add tbo for TBO offers. With TBO_LIVE_ENABLED=false → SIMULATED (SIM-TBO PNRs).
# With TBO_LIVE_ENABLED=true + credentials → live HTTP (FC Phase 1).
INVENTORY_SUPPLIERS="mock_supplier"

# FC Phase 1 — TBO live spine (off by default)
TBO_LIVE_ENABLED="false"
TBO_BASE_URL=""
TBO_CLIENT_ID=""
TBO_USER_NAME=""
TBO_PASSWORD=""
TBO_END_USER_IP="127.0.0.1"
TBO_HTTP_TIMEOUT_SECONDS="60"
TBO_AUTO_TICKET="true"
# Optional path overrides if supplier Rest version differs:
# TBO_AUTH_PATH="/SharedData.svc/rest/Authenticate"
# TBO_SEARCH_PATH="/BookingEngineService_Air/AirService.svc/rest/Search"
# TBO_FARE_QUOTE_PATH="/BookingEngineService_Air/AirService.svc/rest/FareQuote"
# TBO_BOOK_PATH="/BookingEngineService_Air/AirService.svc/rest/Book"
# TBO_TICKET_PATH="/BookingEngineService_Air/AirService.svc/rest/Ticket"
# TBO_CANCEL_PATH="/BookingEngineService_Air/AirService.svc/rest/ReleasePNR"
# TBO_BOOKING_DETAILS_PATH="/BookingEngineService_Air/AirService.svc/rest/GetBookingDetails"

# Look-to-book / shopping cache (live-inventory readiness Phase 0–2)
# Provisional defaults until Sahil fills docs/phase-0/SUPPLIER_L2B_CONTRACT.md
L2B_WARN_RATIO="80"
L2B_CRITICAL_RATIO="120"
# Phase 4 — per-org L2B brakes
L2B_THROTTLE_MIN_CONFIRMED="1"
L2B_ORG_CACHE_ONLY="false"
L2B_AI_BLOCK_ON_CRITICAL="true"
# Phase 7 — auto soft-brakes when platform L2B is critical
L2B_SURVIVAL_ENABLED="true"
L2B_SURVIVAL_TTL_MULTIPLIER="2"
L2B_SURVIVAL_TTL_CAP_SECONDS="900"
L2B_SURVIVAL_PAUSE_WARM_REFRESH="true"
SEARCH_CACHE_ENABLED="false"
SEARCH_CACHE_TTL_SECONDS="120"
# Phase 5 — background hot-route refresh (requires SEARCH_CACHE_ENABLED=true + Redis)
SEARCH_CACHE_REFRESH_ENABLED="false"
SEARCH_CACHE_REFRESH_INTERVAL_SECONDS="60"
SEARCH_CACHE_HOT_TTL_SECONDS="90"
SEARCH_CACHE_WARM_TTL_SECONDS="600"
SEARCH_CACHE_TOP_N="50"
SEARCH_CACHE_HOT_TOP_N="10"

# Quote TTL hours (Phase 3). Use 2 for flights when going live if supplier inventory is volatile.
QUOTE_FLIGHT_TTL_HOURS="4"
QUOTE_HOTEL_TTL_HOURS="12"
